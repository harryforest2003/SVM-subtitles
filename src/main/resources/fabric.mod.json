{
	"schemaVersion": 1,
	"id": "svm_subtitles",
	"version": "${version}",
	"name": "SVM Subtitles",
	"description": "Turns Simple Voice Chat speech into chat messages with the speaker's name, using OpenAI's Whisper. Live captions, name alerts, English translation, text-to-speech and moderation history; heavy work can run on a separate speech server.",
	"authors": [
		"harryforest2003"
	],
	"contact": {
		"homepage": "https://github.com/harryforest2003/SVM-subtitles",
		"sources": "https://github.com/harryforest2003/SVM-subtitles",
		"issues": "https://github.com/harryforest2003/SVM-subtitles/issues"
	},
	"license": "MIT",
	"icon": "assets/svm_subtitles/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.harryforest2003.svmsubtitles.SvmSubtitles"
		],
		"client": [
			"io.github.harryforest2003.svmsubtitles.client.SvmSubtitlesClient"
		],
		"voicechat": [
			"io.github.harryforest2003.svmsubtitles.voice.SubtitlesVoicechatPlugin"
		],
		"modmenu": [
			"io.github.harryforest2003.svmsubtitles.client.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"voicechat": ">=2.6.0"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	},
	"mixins": [
		{
			"config": "svm_subtitles.client.mixins.json",
			"environment": "client"
		}
	]
}
